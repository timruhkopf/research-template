# Runtime settings change speed, not results. They are not logged as params (see tracking/params.py).
# If an experiment varies one of them (e.g. precision), move it into that experiment's semantic config.
deterministic: false
num_workers: 0
[% if training %]
fabric:
  _target_: lightning.fabric.Fabric
  accelerator: auto       # cpu | gpu | auto
  devices: 1
  strategy: auto
  precision: 32-true      # bf16-mixed on GPUs
[% endif %]
