{
  "permissions": {
    "allow": [
      "Bash(just test:*)", "Bash(just test-all:*)", "Bash(just lint)", "Bash(just fmt)", "Bash(just smoke)",
      "Bash(just run local:*)", "Bash(just sweep local:*)", "Bash(just sweep-status:*)", "Bash(just runs:*)",
      "Bash(just snapshot:*)", "Bash(just notebook:*)", "Bash(just notebooks-check)", "Bash(just refs-check)",
      "Bash(just log-index)", "Bash(just new-experiment:*)", "Bash(just remote-ps)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git push:*)", "Bash(just push)", "Bash(just pull:*)", "Bash(just remote:*)", "Bash(just remote-setup:*)",
      "Bash(just run detached:*)", "Bash(just run slurm:*)", "Bash(just sweep detached:*)", "Bash(just sweep slurm:*)",
      "Bash(just sweep-resume:*)", "Bash(just decide:*)", "Bash(just reproduce:*)", "Bash(sbatch:*)", "Bash(ssh:*)"
    ],
    "deny": [
      "Read(./.env.secrets)", "Bash(pip install:*)", "Bash(pkill:*)", "Bash(pgrep:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh" }]
      }
    ]
  }
}
