import datetime as dt
import json
from pathlib import Path

import optuna
import pytest

from [[ package_name ]].tracking import sweep
from [[ package_name ]].tracking.optuna_study import _load, create, reap, study_status, worker


@pytest.mark.slow
def test_worker_budget_and_reap(runs_root: Path, root: Path) -> None:
    d = create(
        "pilot",
        ["experiment=debug"],
        "toy_regression",
        command="cmd",
        backend="local",
        log_dir=root / "research_log",
        allow_dirty=True,
    )
    study, search = _load(d)
    (d / "study.json").write_text(json.dumps({**search, "n_trials": 3}))
    worker(d)
    assert "3/3 trials" in study_status(d)
    assert sweep.counts(d) == {"DONE": 3}  # trials are ordinary sweep members

    # a trial whose worker died: RUNNING forever until reaped
    study.ask()
    assert reap(d, stale_h=24.0) == 0
    assert reap(d, stale_h=24.0, now=dt.datetime.now() + dt.timedelta(hours=48)) == 1
    states = [t.state for t in _load(d)[0].get_trials()]
    assert optuna.trial.TrialState.FAIL in states and optuna.trial.TrialState.WAITING in states
