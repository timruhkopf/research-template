# Template-owned: changes come from `copier update`. Project-specific recipes go in project.just.
# Recipes are thin wrappers: `just sweep ...` == `python -m [[ package_name ]].tracking.cli sweep ...`.
set dotenv-load
set positional-arguments
import? 'project.just'

extra := env("[[ package_name|upper ]]_TORCH_EXTRA", "cpu")
py := "uv run --extra " + extra + " python"
cli := py + " -m [[ package_name ]].tracking.cli"
[% if "remote" in compute %]
remote_host := env("[[ package_name|upper ]]_REMOTE_HOST", "")
remote_dir := env("[[ package_name|upper ]]_REMOTE_DIR", "")
[% endif %]

default:
    @just --list --unsorted

# uv sync with a torch extra (cpu | [[ cuda_extra ]]), git hooks, .env from envs/<setup>.env.example
setup extra setup="local":
    uv sync --extra {{extra}} {{ if setup == "local" { "--group notebooks" } else { "" } }}
    [ -f .env ] || cp envs/{{setup}}.env.example .env
    grep -q '^[[ package_name|upper ]]_TORCH_EXTRA=' .env || echo '[[ package_name|upper ]]_TORCH_EXTRA={{extra}}' >> .env
    {{ if setup == "local" { "uv run --extra " + extra + " pre-commit install --hook-type pre-commit --hook-type pre-push" } else { "true" } }}

# switch the active machine settings (.env) to envs/<setup>.env.example
use-env setup:
    cp envs/{{setup}}.env.example .env
    echo '[[ package_name|upper ]]_TORCH_EXTRA={{extra}}' >> .env

# tiny end-to-end scratch run
smoke:
    {{py}} -m [[ package_name ]].main experiment=debug

# fast tests / everything (slow, integration)
test *args:
    {{py}} -m pytest "$@"
test-all *args:
    {{py}} -m pytest -m "" "$@"

lint:
    uv run --extra {{extra}} ruff check .
    uv run --extra {{extra}} ruff format --check .
    uv run --extra {{extra}} pyright

fmt:
    uv run --extra {{extra}} ruff format .
    uv run --extra {{extra}} ruff check --fix .

# one tracked run: just run <local|detached|slurm> <stage> experiment=<name> [overrides]
run *args:
    {{cli}} run "$@"

# a tracked sweep: just sweep <local|detached|slurm> <stage> experiment=<name> seed=0,1,2 ...
sweep *args:
    {{cli}} sweep "$@"

sweep-status dir:
    {{cli}} sweep-status "$@"

# re-execute members that are not DONE (check sweep-status first: STARTED may still be running)
sweep-resume *args:
    {{cli}} sweep-resume "$@"

# tidy table of a sweep: varying params, summary metrics, status
runs dir:
    {{cli}} runs "$@"

# record a verdict in the experiment's log entry: just decide <sweep dir> <GO|NO_GO|INCONCLUSIVE> "<reason>"
decide dir verdict reason:
    {{cli}} decide "$@"

# export a sweep into results/ for notebooks and figures
snapshot dir:
    {{cli}} snapshot "$@"

# rerun a sweep at its commit in a git worktree and compare summaries
reproduce *args:
    {{cli}} reproduce "$@"

# new experiment: config + notebook (description first) + log entry
new-experiment name title:
    {{cli}} new-experiment "$@"

log-index:
    {{cli}} log-index

refs-check:
    {{cli}} refs-check

# execute every notebook against its snapshot (outputs discarded; CI)
notebooks-check:
    #!/usr/bin/env bash
    set -euo pipefail
    out=$(mktemp -d)
    shopt -s nullglob
    for nb in notebooks/*.ipynb; do
        echo "executing $nb"
        uv run --extra {{extra}} --group notebooks jupyter nbconvert --to notebook --execute --output-dir "$out" "$nb"
    done

# execute a notebook in place, keeping outputs (then commit it)
notebook nb:
    uv run --extra {{extra}} --group notebooks jupyter nbconvert --to notebook --execute --inplace "$@"

# regenerate reports/figures/ (each scripts/figures/*.py reads final-stage snapshots)
figures:
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob
    for f in scripts/figures/*.py; do echo "$f"; {{py}} "$f"; done
[% if "remote" in compute %]

# --- remote box ([[ package_name|upper ]]_REMOTE_HOST / _REMOTE_DIR in .env) ---------------------------

# rsync code incl. .git to the remote (the remote tree must be a clean commit for tracked runs)
push:
    rsync -az --delete --exclude .venv --exclude runs --exclude data --exclude checkpoints --exclude .env \
        --exclude .env.secrets --exclude __pycache__ --exclude .idea --exclude mlflow.db ./ {{remote_host}}:{{remote_dir}}/

# rsync one experiment's runs back: just pull <experiment>
pull experiment:
    mkdir -p runs/{{experiment}}
    rsync -az {{remote_host}}:{{remote_dir}}/runs/{{experiment}}/ runs/{{experiment}}/

# once per dependency change: sync the remote venv (extra defaults to [[ cuda_extra ]])
remote-setup extra="[[ cuda_extra ]]":
    ssh {{remote_host}} 'cd {{remote_dir}} && PATH=$HOME/.local/bin:$PATH uv sync --extra {{extra}} && ([ -f .env ] || cp envs/remote.env.example .env) && (grep -q TORCH_EXTRA .env || echo [[ package_name|upper ]]_TORCH_EXTRA={{extra}} >> .env)'

# run a cli command on the remote, e.g. just remote sweep detached pilot experiment=x seed=0,1,2
remote *args:
    ssh {{remote_host}} "cd {{remote_dir}} && .venv/bin/python -m [[ package_name ]].tracking.cli $(printf '%q ' "$@")"

# what is running on the remote (verify a launch before relaunching)
remote-ps:
    ssh {{remote_host}} 'ps -eo pid,etime,args | grep -E "[t]racking.cli|[[ package_name ]].main" || echo "nothing running"'
[% endif %]
[% if mlflow %]

# --- MLflow viewer ------------------------------------------------------------------------------

# push run sinks to MLflow (one way, idempotent); default: all of runs/
mlflow-sync *paths:
    {{cli}} mlflow-sync "$@"

mlflow-ui:
    uv run --extra {{extra}} mlflow ui --backend-store-uri "${[[ package_name|upper ]]_MLFLOW_URI:-sqlite:///$PWD/mlflow.db}"
[% endif %]
[% if optuna %]

# --- Optuna --------------------------------------------------------------------------------------

# just optuna-create <backend> <stage> --search <name> [--workers N] experiment=<name> [overrides]
optuna-create *args:
    {{cli}} optuna-create "$@"

optuna-status dir:
    {{cli}} optuna-status "$@"

# re-enqueue RUNNING trials older than --stale-h (run by hand: a single writer)
optuna-reap *args:
    {{cli}} optuna-reap "$@"
[% endif %]
