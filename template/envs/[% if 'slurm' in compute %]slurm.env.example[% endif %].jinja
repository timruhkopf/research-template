# .env on the cluster login node. Compute nodes have no internet: sync there; jobs use .venv/bin/python.
# Absolute paths only (no $USER): .env is read by just and Python, which don't expand variables alike.
# Runs must be on the shared filesystem.
[[ package_name|upper ]]_SETUP=slurm
[[ package_name|upper ]]_TORCH_EXTRA=[[ cuda_extra ]]
[[ package_name|upper ]]_RUNS_ROOT=/scratch/<user>/[[ project_name ]]/runs
[[ package_name|upper ]]_DATA_ROOT=/scratch/<user>/[[ project_name ]]/data
[[ package_name|upper ]]_CKPT_ROOT=/scratch/<user>/[[ project_name ]]/checkpoints
SBATCH_ACCOUNT=
SBATCH_PARTITION=
UV_CACHE_DIR=/scratch/<user>/.cache/uv
