# Copied to .env by `just setup <extra> local`. Machine-specific settings only; never commit .env.
[[ package_name|upper ]]_SETUP=local
[[ package_name|upper ]]_TORCH_EXTRA=cpu
# [[ package_name|upper ]]_RUNS_ROOT=/path/to/runs        default: <repo>/runs
# [[ package_name|upper ]]_DATA_ROOT=/path/to/data        default: <repo>/data
[% if "remote" in compute %]
[[ package_name|upper ]]_REMOTE_HOST=<ssh-alias>
[[ package_name|upper ]]_REMOTE_DIR=PycharmProjects/[[ project_name ]]
[% endif %]
[% if mlflow %]
# [[ package_name|upper ]]_MLFLOW_URI=sqlite:////path/to/mlflow.db   default: <repo>/mlflow.db
[% endif %]
